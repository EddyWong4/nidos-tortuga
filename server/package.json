{
  "name": "nidos-tortuga-servidor",
  "private": true,
  "version": "0.1.0",
  "description": "API de sincronización para Nidos de Tortuga (Fastify + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "demo": "tsx src/demo.ts",
    "dispositivo:crear": "tsx src/crearDispositivo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
